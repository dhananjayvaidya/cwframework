{
    "name": "dhananjayvaidya/cwframework",
    "type": "project",
    "description": "Modern PHP 8.5 Framework for AI and Traditional Web Applications",
    "keywords": ["php", "mvc", "framework", "ai", "openai", "anthropic", "php8.5"],
    "homepage": "https://cwframework.com",
    "license": "MIT",
    "version": "3.0.0",
    "authors": [
        {
            "name": "Dhananjay Vaidya",
            "email": "dhananjay@zitasoftinfotech.com",
            "homepage": "https://dhananjayvaidya.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "ext-redis": "*",
        "openai-php/client": "^0.10",
        "anthropic-ai/sdk": "^1.0",
        "predis/predis": "^2.2",
        "monolog/monolog": "^3.5",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "guzzlehttp/guzzle": "^7.8",
        "symfony/console": "^7.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "psr/cache": "^3.0",
        "pgvector/pgvector": "^0.2",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.48"
    },
    "autoload": {
        "psr-4": {
            "CWF\\": "core/",
            "App\\Controllers\\": "http/controllers/",
            "App\\Models\\": "http/models/",
            "App\\Middleware\\": "http/middleware/"
        },
        "files": [
            "core/helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "php-cs-fixer fix"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
